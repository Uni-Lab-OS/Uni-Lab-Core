    "python_source": "from typing import TypedDict\nfrom c1_lifecycle.device import MeasurementDevice\nfrom production_lab.workflows.composite_child import published_child\nfrom unilabos.workflow.authoring import device, workflow_definition\n\n\nclass C1CompositeParentResult(TypedDict):\n    report: float\n\n\nmeasurement_device: MeasurementDevice = device()\n\n\n@workflow_definition(\n    workflow_uuid='10000000-0000-4000-8000-000000000007',\n    displayname='C1 Composite parent',\n    description='Real PackageCatalog Composite browser gate.',\n)\ndef c1__composite_parent() -> C1CompositeParentResult:\n    # unilab:node_uuid=20000000-0000-4000-8000-000000000063\n    prepared = measurement_device.measure(value=1)\n    # unilab:node_uuid=20000000-0000-4000-8000-000000000062\n    child = published_child(value=prepared.result)\n    # unilab:node_uuid=20000000-0000-4000-8000-000000000064\n    finalized = measurement_device.measure(value=child.result)\n    return {'report': finalized.result}\n",
    "draft_hash": "sha256:9996f324ca65faf866f127feae0de104fc8c698653a4a69b83b1e808fb7c94ef",
