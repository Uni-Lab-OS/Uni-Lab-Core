        "python_source": "from typing import Annotated, Literal\nfrom pydantic import Field\nfrom lab.devices import Reactor\nfrom unilabos.registry.placeholder_type import ResourceSlot\nfrom unilabos.workflow.authoring import device, workflow_definition, workflow_output\n\n\nreactor: Reactor = device()\n\n\n@workflow_definition(\n    workflow_uuid='10000000-0000-4000-8000-000000000001',\n    displayname='Sample preparation',\n    description='Prepare and analyze one sample.',\n)\ndef sample_preparation(\n    *,\n    sample: ResourceSlot,\n    cycles: Annotated[int, Field(ge=1, le=10)] = 7,\n    mode: Literal['fast', 'safe'] = 'safe',\n    note: Annotated[str | None, Field(max_length=200)] = None,\n):\n    # unilab:node_uuid=20000000-0000-4000-8000-000000000001\n    imported_json_node = reactor.prepare(cycles=cycles, note=note, sample=sample)\n    # unilab:node_uuid=20000000-0000-4000-8000-000000000002\n    analyzed = reactor.analyze(label=mode, prepared=imported_json_node.prepared)\n    return workflow_output(sample=imported_json_node.prepared, report=analyzed.report)\n",
